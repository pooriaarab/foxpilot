{
  "name": "foxpilot",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.11.0",
  "description": "foxpilot: a browser agent that runs entirely in Firefox, with GLiNER2 (and an optional small LLM) on WebGPU",
  "type": "module",
  "bin": {
    "foxpilot": "bin/foxpilot.mjs"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "lint:ext": "web-ext lint -s dist",
    "ci:local": "pnpm typecheck && pnpm test && pnpm build && pnpm lint:ext",
    "e2e": "pnpm build && node scripts/e2e.mjs",
    "bench:firefox": "node bench/run.mjs",
    "eval": "pnpm build && node scripts/zoo/cli.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.0",
    "@types/node": "^26.6.2",
    "esbuild": "^0.28.2",
    "playwright": "1.63.0",
    "puppeteer": "^25.13.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1",
    "web-ext": "^10.7.0"
  }
}
